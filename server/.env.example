# Settings for the Қоян server. On Render they go into Dashboard → unihop-koyan → Environment.
# For a local test, copy this file to server/.env (it is git-ignored) and fill in KIMI_API_KEY yourself.

# Required. Kimi Open Platform key (pay-as-you-go API, https://platform.kimi.ai). Server only — never in the site code.
KIMI_API_KEY=

# Firebase project whose Google sign-in tokens are accepted.
FIREBASE_PROJECT_ID=unihop-88ba6
# Recommended on Render: JSON key of a service account with the "Cloud Datastore User" role, on one line.
# Lets the server keep limits in Firestore across restarts. Without it, limits reset whenever the free service sleeps.
FIREBASE_SERVICE_ACCOUNT=

# Model and address — check the model list on platform.kimi.ai before changing.
KIMI_MODEL=kimi-k3.1-pro
KIMI_BASE_URL=https://api.moonshot.ai/v1
# low | high | max — K3.1 Pro always reasons; "low" is faster and cheaper.
KIMI_REASONING_EFFORT=low

# false = chat off; the site shows "Чат временно недоступен".
KOYAN_ENABLED=true
# Sites allowed to call the server (comma-separated). Add http://localhost:5173 only for local development.
KOYAN_ALLOWED_ORIGINS=https://unihop-88ba6.web.app,https://unihop-88ba6.firebaseapp.com
# Any random text; used to hash network addresses for limits.
KOYAN_HASH_SALT=

# Size limits
KOYAN_MAX_INPUT_CHARS=1200
# Longest motivation-letter draft the letter coach accepts (characters).
KOYAN_MAX_DRAFT_CHARS=5000
KOYAN_HISTORY_TURNS=8
KOYAN_HISTORY_CHARS=8000
KOYAN_MAX_OUTPUT_TOKENS=2500
KOYAN_MAX_TOOL_ROUNDS=2
KOYAN_MAX_RETRIES=1

# Usage limits
KOYAN_USER_DAILY_MESSAGES=30
KOYAN_IP_DAILY_MESSAGES=60
KOYAN_MAX_CONCURRENT_PER_USER=1

# Spending caps: new requests stop when reached.
KOYAN_DAILY_TOKEN_CAP=1000000
KOYAN_MONTHLY_TOKEN_CAP=10000000
# Optional dollar cap: copy current prices (USD per 1M tokens) from the official Kimi price page; 0 = off.
KIMI_PRICE_INPUT_PER_M=0
KIMI_PRICE_OUTPUT_PER_M=0
KOYAN_MONTHLY_USD_CAP=0
