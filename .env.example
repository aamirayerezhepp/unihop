# Copy this file to .env.local and paste the values from
# Firebase console → Project settings → Your apps → Web app → SDK setup and configuration.
# With these empty, the site works without Google sign-in (data stays in the browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Қоян chat: address of the deployed Cloud Function (see KOYAN-SETUP.md). Empty = the site says "Чат временно недоступен".
# No API key here — the Kimi key lives only on the server.
VITE_KOYAN_URL=
