{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", "test", ".env.example", "*.log"],
      "predeploy": ["node \"$PROJECT_DIR/scripts/build-kb.mjs\""]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
