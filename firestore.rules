rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each student has one document, users/{uid}. Only that signed-in student can read or write it.
    // Anything else in the database is closed to everyone.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
