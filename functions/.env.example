# Settings for the Қоян chat function. Copy to functions/.env to change a value; every line is optional.
# The API key is NOT set here. Set it once in Secret Manager from your own terminal:
#   firebase functions:secrets:set KIMI_API_KEY --project unihop-88ba6
# and paste the key when asked (it is not shown on screen and never stored in the repository).

# Kimi Open Platform (pay-as-you-go API: https://platform.kimi.ai). Check the model list there before changing.
KIMI_MODEL=kimi-k3.1-pro
KIMI_BASE_URL=https://api.moonshot.ai/v1
# low | high | max — K3.1 Pro always reasons; "low" keeps answers faster and cheaper.
KIMI_REASONING_EFFORT=low

# false = chat switched off; the site shows "Чат временно недоступен".
KOYAN_ENABLED=true
# Sites allowed to call the function (comma-separated).
KOYAN_ALLOWED_ORIGINS=https://unihop-88ba6.web.app,https://unihop-88ba6.firebaseapp.com,http://localhost:5173
# Any random text; used to hash network addresses for limits.
KOYAN_HASH_SALT=change-me

# Size limits
KOYAN_MAX_INPUT_CHARS=1200
KOYAN_HISTORY_TURNS=8
KOYAN_HISTORY_CHARS=8000
# Includes the model's hidden reasoning tokens.
KOYAN_MAX_OUTPUT_TOKENS=2500
KOYAN_MAX_TOOL_ROUNDS=2
KOYAN_MAX_RETRIES=1

# Usage limits
KOYAN_USER_DAILY_MESSAGES=30
KOYAN_IP_DAILY_MESSAGES=60
KOYAN_MAX_CONCURRENT_PER_USER=1

# Spending caps: new requests stop when a cap is reached (the site says the daily limit is used up).
KOYAN_DAILY_TOKEN_CAP=3000000
KOYAN_MONTHLY_TOKEN_CAP=40000000
# Optional money cap. Copy current prices (US dollars per 1M tokens) from the Kimi price page; 0 = not used.
KIMI_PRICE_INPUT_PER_M=0
KIMI_PRICE_OUTPUT_PER_M=0
KOYAN_MONTHLY_USD_CAP=0
